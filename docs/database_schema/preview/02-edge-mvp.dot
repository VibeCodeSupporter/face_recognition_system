digraph schema {
graph [rankdir=TB, bgcolor="white", nodesep=0.6, ranksep=1.45, splines=polyline, pad=0.35, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#687582", arrowsize=0.8, dir=both, labeldistance=1.5];
"local_users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#c5ced6"><TR><TD COLSPAN="3" BGCOLOR="#e7f4f5" HEIGHT="38"><FONT COLOR="#235c65" POINT-SIZE="15"><B>local_users</B></FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">PK</FONT></TD><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="12">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="face_template_json" ALIGN="LEFT"><FONT POINT-SIZE="12">face_template_json ?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="cloud_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="12">cloud_updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR></TABLE>>];
"local_device" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#c5ced6"><TR><TD COLSPAN="3" BGCOLOR="#e7f4f5" HEIGHT="38"><FONT COLOR="#235c65" POINT-SIZE="15"><B>local_device</B></FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">PK</FONT></TD><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="name" ALIGN="LEFT"><FONT POINT-SIZE="12">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="settings_json" ALIGN="LEFT"><FONT POINT-SIZE="12">settings_json</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="last_sync_at" ALIGN="LEFT"><FONT POINT-SIZE="12">last_sync_at ?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR></TABLE>>];
"local_access_logs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#c5ced6"><TR><TD COLSPAN="3" BGCOLOR="#e7f4f5" HEIGHT="38"><FONT COLOR="#235c65" POINT-SIZE="15"><B>local_access_logs</B></FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">PK</FONT></TD><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="user_id" ALIGN="LEFT"><FONT POINT-SIZE="12">user_id ?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="device_id" ALIGN="LEFT"><FONT POINT-SIZE="12">device_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="result" ALIGN="LEFT"><FONT POINT-SIZE="12">result</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="confidence" ALIGN="LEFT"><FONT POINT-SIZE="12">confidence ?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">real</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="access_time" ALIGN="LEFT"><FONT POINT-SIZE="12">access_time</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" HEIGHT="25"><FONT POINT-SIZE="10" COLOR="#576473">&#160;</FONT></TD><TD PORT="synced_at" ALIGN="LEFT"><FONT POINT-SIZE="12">synced_at ?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#576473">text</FONT></TD></TR></TABLE>>];
}
